	<summary>
		<band height="320" splitType="Stretch">
			<line>
				<reportElement x="10" y="10" width="535" height="1" uuid="21b29a28-9854-47bf-a1b7-a37a8597f742"/>
			</line>
			<pieChart>
				<chart evaluationTime="Report">
					<reportElement x="50" y="40" width="455" height="250" uuid="31b29a28-9854-47bf-a1b7-a37a8597f742"/>
					<chartTitle>
						<titleExpression><![CDATA["Distribución de Ingresos de Café Origen"]]></titleExpression>
					</chartTitle>
					<chartSubtitle/>
					<chartLegend/>
				</chart>
				<pieDataset>
					<keyExpression><![CDATA[$F{categoria_ingreso}]]></keyExpression>
					<valueExpression><![CDATA[$F{total_monto}]]></valueExpression>
