				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="12" isBold="false"/>
				</textElement>
				<text><![CDATA[Consolidado de Ventas]]></text>
			</staticText>
		</band>
	</title>
	<pageHeader>
		<band height="30" splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band height="30" splitType="Stretch">
			<rectangle>
				<reportElement x="10" y="0" width="535" height="25" backcolor="#F5F5F0" uuid="d1b29a28-9854-47bf-a1b7-a37a8597f742"/>
				<graphicElement>
					<pen lineWidth="0.0"/>
				</graphicElement>
			</rectangle>
			<staticText>
				<reportElement x="20" y="5" width="280" height="20" uuid="e1b29a28-9854-47bf-a1b7-a37a8597f742"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Concepto / Categoría de Ingreso]]></text>
			</staticText>
