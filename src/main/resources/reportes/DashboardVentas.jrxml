				<reportElement x="380" y="5" width="150" height="20" uuid="f1b29a28-9854-47bf-a1b7-a37a8597f742"/>
				<textElement textAlignment="Right">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Ingreso Total Acumulado]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="30" splitType="Stretch">
			<textField>
				<reportElement x="20" y="5" width="280" height="20" uuid="01b29a28-9854-47bf-a1b7-a37a8597f742"/>
				<textFieldExpression><![CDATA[$F{categoria_ingreso}]]></textFieldExpression>
			</textField>
			<textField pattern="S/ #,##0.00">
				<reportElement x="380" y="5" width="150" height="20" forecolor="#2E7D32" uuid="11b29a28-9854-47bf-a1b7-a37a8597f742"/>
				<textElement textAlignment="Right">
					<font isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["S/ " + $F{total_monto}]]></textFieldExpression>
			</textField>
